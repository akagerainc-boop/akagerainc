# ============================================================
# Akagera Inc API — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Database (MySQL) ---
# Either provide a full DATABASE_URL...
DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname?charset=utf8mb4
# ...or the individual parts (used if DATABASE_URL is empty):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=akagerainc
DB_USER=root
DB_PASSWORD=

# --- App / security ---
DEBUG=False
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=168
# Comma-separated list of allowed browser origins (no "*")
ALLOWED_ORIGINS=http://localhost:3000,https://akagerainc.store
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_MB=25
MAX_INSTALLER_MB=300

# --- Admin bootstrap (first boot creates/updates this super admin) ---
ADMIN_EMAIL=admin@akagerainc.store
ADMIN_PASSWORD=change-me-strong-password
# Legacy simple admin password (kept as fallback during migration)
ADMIN_PASSWORD_LEGACY=Admin@Akagera2024!

# --- Firebase (used only to display project id; verification is client-side) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=ussd-1-9aa3a

# --- Payments: Stripe ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# --- Payments: ITEC (MoMo / card, Rwanda) ---
ITEC_API_KEY=

# --- Email OTP via Resend (https://resend.com) ---
RESEND_API_KEY=re_your_resend_api_key
# "From" address — the domain must be verified in Resend.
RESEND_FROM=Prism Scanner <no-reply@akagerainc.store>
OTP_TTL_MINUTES=10

# --- Email (SMTP) — legacy / optional ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# --- License config ---
LICENSE_KEY_LENGTH=10
